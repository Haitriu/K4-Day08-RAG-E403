# OpenRouter API key (provider ưu tiên)
OPENROUTER_API_KEY=sk-or-v1-...
# OPENROUTER_MODEL=inclusionai/ling-3.0-flash:free

# OpenAI API key (fallback khi OpenRouter rate-limit hoặc model không khả dụng)
# OPENAI_API_KEY=sk-proj-...
# OPENAI_MODEL=gpt-4o-mini

# Gemini API Key (Tùy chọn - fallback nếu OpenRouter và OpenAI đều không có/hết quota)
# GEMINI_API_KEY=...

# PageIndex API Key (Tùy chọn - dùng cho Task 8: Vectorless RAG fallback)
# PAGEINDEX_API_KEY=pix_...

# Jina API Key (Tùy chọn - dùng cho Task 7: Cross-encoder reranking via Jina API)
# JINA_API_KEY=jina_...

# Embedding local đa ngôn ngữ dùng chung cho index và query.
# EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# EMBEDDING_DIM=384
# EMBEDDING_LOCAL_FILES_ONLY=true
# Lưu ý: đổi model/dimension phải tạo lại chroma_db bằng Task 4.
